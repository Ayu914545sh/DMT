# Unified MCA & GST Data Management Webapp Configuration

# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# PostgreSQL Database
DB_ENGINE=postgresql
DB_NAME=dmt_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=postgres
DB_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ALWAYS_EAGER=False
